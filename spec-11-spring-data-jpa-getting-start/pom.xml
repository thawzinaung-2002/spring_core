		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.10</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

  <build>
  	<plugins>
  		<plugin>
  			<groupId>org.apache.maven.plugins</groupId>
  			<artifactId>maven-compiler-plugin</artifactId>
  			<configuration>
  				<release>21</release>
  			</configuration>
  		</plugin>
  	</plugins>
  </build>
  
  
  <modules>
  	<module>pj01-spring-data-jpa-xml</module>
  	<module>pj02-spring-data-jpa-java</module>
  	<module>pj03-spring-data-jpa-boots</module>
  </modules>
</project>